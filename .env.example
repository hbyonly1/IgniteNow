# Docker Compose host ports
APP_PORT=8000
STATIC_BASE_URL=http://localhost:8000/static
VITE_API_BASE_URL=http://localhost:8000
# Docker Compose 内部访问 postgres 服务时使用这个地址。
# 本机直接运行后端时改为：postgresql://postgres:your_secure_password_here@localhost:5432/ignitenow
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/ignitenow

REDIS_PORT=6379
# Docker Compose 内部访问 redis 服务时使用这个地址；
# 本机直接运行后端时改为 redis://localhost:6379/0。
REDIS_URL=redis://redis:6379/0

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ignitenow

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

RQ_QUEUE_NAME=ignitenow

LLM_TIMEOUT_SECONDS=90
LLM_API_KEY=THERE_SHOULD_NOT_BE_ANY_VALID_KEY
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=ep-20260514111117-s7m8b

# Local subtitle ASR via faster-whisper.
# CPU default is slow but portable; use WHISPER_DEVICE=cuda and WHISPER_COMPUTE_TYPE=float16 on NVIDIA GPU hosts.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=zh
